# Copy to .env and fill in. Never commit .env.

# --- Telegram (from @BotFather) ---
BOT_TOKEN=

# --- Optional: Claude analysis. Empty = free local rules. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# 0 = always use local rules even if a key is set
LLM_ENABLED=1

# --- OCR ---
# folder with deu.traineddata (default: ./tessdata, then tesseract's own folder)
TESSDATA_DIR=
TESSERACT_CMD=tesseract
# 6 = one text block (keeps table rows together, works on slightly rotated photos)
TESSERACT_PSM=6

# --- Local emulator (python -m app.web) ---
PORT=8091
# fixed "today" for the demo video, e.g. 2026-11-19 (empty = real date)
DEMO_TODAY=
